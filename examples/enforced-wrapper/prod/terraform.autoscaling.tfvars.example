environment = "prod"
region      = "us-east-1"
# Replace REGION, ACCOUNT_ID and KEY_ID with your values
kms_key_arn  = "arn:aws:kms:REGION:ACCOUNT_ID:key/EXAMPLE-KMS-KEY"
table_definition_path = "table-definition-provisioned.json"

prod_principal_arns = [
  "arn:aws:iam::ACCOUNT_ID:role/app-prod"
]

prod_replica_regions = [
  {
    region_name = "us-west-2"
  }
]

table = {
  billing_mode                          = "PROVISIONED"
  read_capacity                         = 5
  write_capacity                        = 5
  autoscaling_enabled                   = true
  ignore_changes_global_secondary_index = true

  autoscaling_read = {
    scale_in_cooldown  = 50
    scale_out_cooldown = 40
    target_value       = 45
    max_capacity       = 20
  }

  autoscaling_write = {
    scale_in_cooldown  = 50
    scale_out_cooldown = 40
    target_value       = 45
    max_capacity       = 20
  }

  autoscaling_indexes = {
    GSI1 = {
      read_min_capacity  = 5
      read_max_capacity  = 30
      write_min_capacity = 5
      write_max_capacity = 30
    }
  }

  tags = {
    Environment = "prod"
  }
}
